# Copy to .env and adjust for your homelab.
# All values have defaults in compose.yml; override only what differs.

# Prometheus server the backend queries for host metrics.
PROMETHEUS_URL=http://prometheus:9090

# Log verbosity (DEBUG/INFO/WARNING/ERROR). Logs go to stdout — see them
# with `docker compose logs dashboard-api`. Grep for ' scheduler ' to get
# a fleet-wide audit trail of every placement decision.
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API / open the WebSocket.
# Match the host:port the browser loads the dashboard from.
ALLOWED_ORIGINS=http://localhost:8081

# How long to wait for an agent's /containers snapshot each tick, and how
# long to keep serving its last good snapshot (container list + GPU card,
# flagged stale) through a hiccup before showing "agent unreachable".
AGENT_POLL_TIMEOUT=8
AGENT_STALE_GRACE=45

# Shared secret for every mutating API route: agent self-registration
# (X-Register-Token header on POST/DELETE /api/nodes), container control,
# and — importantly — the deployment routes, which pull and run arbitrary
# images on your hosts. Leave blank on a private/Tailscale-only network;
# SET IT before exposing the dashboard API anywhere less trusted, and
# especially before using the Deploy tab. REGISTER_TOKEN is still read as
# an alias for backwards compatibility.
API_TOKEN=

# Optional. Enables backend/llm.py: turns the Deploy tab's free-text
# "notes" into scheduler constraints and writes a short placement
# rationale. Unset = the scheduler runs on the structured form fields
# alone (deterministic scoring is unaffected either way).
ANTHROPIC_API_KEY=

# Sent as X-Agent-Token when the backend calls an agent to create, remove,
# start, stop or restart a container. Must match the AGENT_TOKEN set on the
# homelab-agent instances. Leave blank if the agents don't set one.
AGENT_TOKEN=

# Rebalancing suggestions (GET /api/rebalance). A node over either
# threshold is "hot"; a stateless managed container on it is suggested for
# a move only if another node scores at least REBALANCE_MIN_GAIN better.
REBALANCE_CPU_PERCENT=80
REBALANCE_RAM_PERCENT=85
REBALANCE_MIN_GAIN=15

# Auto-rebalance: when truthy, the backend acts on the suggestions above
# instead of only showing them — moving qualifying *stateless* workloads
# on its own. Off by default. Higher gain bar than a suggestion, one move
# per cycle, and a per-deployment cooldown so a flapping node can't cause
# a move storm.
AUTO_REBALANCE=
AUTO_REBALANCE_INTERVAL=600
AUTO_REBALANCE_MIN_GAIN=30
AUTO_REBALANCE_COOLDOWN=3600
AUTO_REBALANCE_MAX_PER_CYCLE=1

# Alerting. Off unless ALERT_WEBHOOK_URL is set. The backend POSTs a small
# JSON body to that URL on a state change — a host going offline, its
# agent going unreachable, RAM/CPU sitting over threshold, or a
# scheduler-managed deployment going failed/node_offline — and again when
# the condition clears. The body is generic ({status, key, title, message,
# host, timestamp}) so it works with ntfy, Gotify, Discord, Slack-style
# webhooks, healthchecks.io, or your own receiver.
ALERT_WEBHOOK_URL=
ALERT_RAM_PERCENT=90
ALERT_CPU_PERCENT=95
# Seconds between checks.
ALERT_INTERVAL=60
# Consecutive over-threshold checks before a RAM/CPU alert fires (a single
# spike won't page you). Host-offline and deployment-failed fire on the
# first check regardless.
ALERT_BREACH_CYCLES=2

# The machine running the dashboard is auto-detected (it matches its own
# container ID against the container lists reported by each registered
# agent) and gets its own full-width "Main System" section at the top.
# You don't need to set this — it's only an override for the rare case
# where auto-detection doesn't apply, e.g. the dashboard runs on a host
# with no homelab-agent on it. Set it to that machine's Prometheus job /
# agent HOST_NAME.
MAIN_HOST=

# Nodes are no longer listed here. Each homelab-agent registers itself on
# startup (see homelab-agent's DASHBOARD_URL / AGENT_URL / REGISTER_TOKEN
# env vars) and is picked up on the next WebSocket tick — nothing to edit
# in this repo when you add a machine.
