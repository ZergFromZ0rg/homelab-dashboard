# Copy to .env and adjust for your homelab.
# All values have defaults in compose.yml; override only what differs.

# Prometheus server the backend queries for host metrics.
PROMETHEUS_URL=http://prometheus:9090

# Log verbosity (DEBUG/INFO/WARNING/ERROR). Logs go to stdout — see them
# with `docker compose logs dashboard-api`. Grep for ' scheduler ' to get
# a fleet-wide audit trail of every placement decision.
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API / open the WebSocket.
# Match the host:port the browser loads the dashboard from.
ALLOWED_ORIGINS=http://localhost:8081

# How long to wait for an agent's /containers snapshot each tick, and how
# long to keep serving its last good snapshot (container list + GPU card,
# flagged stale) through a hiccup before showing "agent unreachable".
AGENT_POLL_TIMEOUT=8
AGENT_STALE_GRACE=45

# Shared secret for every mutating API route: agent self-registration
# (X-Register-Token header on POST/DELETE /api/nodes), container control,
# and — importantly — the deployment routes, which pull and run arbitrary
# images on your hosts. Leave blank on a private/Tailscale-only network;
# SET IT before exposing the dashboard API anywhere less trusted, and
# especially before using the Deploy tab. REGISTER_TOKEN is still read as
# an alias for backwards compatibility.
API_TOKEN=

# Sent as X-Agent-Token when the backend calls an agent to create, remove,
# start, stop or restart a container. Must match the AGENT_TOKEN set on the
# homelab-agent instances. Leave blank if the agents don't set one.
AGENT_TOKEN=

# Rebalancing suggestions (GET /api/rebalance). A node over either
# threshold is "hot"; a stateless managed container on it is suggested for
# a move only if another node scores at least REBALANCE_MIN_GAIN better.
REBALANCE_CPU_PERCENT=80
REBALANCE_RAM_PERCENT=85
REBALANCE_MIN_GAIN=15

# Auto-rebalance: when truthy, the backend acts on the suggestions above
# instead of only showing them — moving qualifying *stateless* workloads
# on its own. Off by default. Higher gain bar than a suggestion, one move
# per cycle, and a per-deployment cooldown so a flapping node can't cause
# a move storm.
AUTO_REBALANCE=
AUTO_REBALANCE_INTERVAL=600
AUTO_REBALANCE_MIN_GAIN=30
AUTO_REBALANCE_COOLDOWN=3600
AUTO_REBALANCE_MAX_PER_CYCLE=1

# Alerting. The rules are always evaluated — they feed the Overview's
# Attention panel and its Alert history card. Set # --- Volume backups -------------------------------------------------------
# Schedules and retention live in the UI (Backups tab), not here — these
# only set the defaults a new job starts with and how the loop behaves.
# The destination side is configured on the *agent* (BACKUP_DIRS).

# Defaults for a newly added job.
VOLUME_BACKUP_INTERVAL_HOURS=24
VOLUME_BACKUP_KEEP=7

# How often the scheduler checks whether anything is due. Backups run
# hours apart; this only bounds how late one can start.
VOLUME_BACKUP_TICK=60

# How often a running backup is polled, and when to stop watching one.
# Giving up watching does not stop the backup — the agent finishes it.
VOLUME_BACKUP_POLL=10
VOLUME_BACKUP_MAX_SECONDS=21600

VOLUME_BACKUPS_FILE=/data/volume_backups.json

ALERT_WEBHOOK_URL to
# also have the backend POST a small JSON body there on a state change —
# a host going offline, its agent going unreachable, RAM/CPU sitting over
# threshold, or a scheduler-managed deployment going failed/node_offline
# — and again when the condition clears. The body is generic ({status,
# key, title, message, host, severity, timestamp}) so it works with ntfy,
# Gotify, Discord, Slack-style webhooks, healthchecks.io, or your own
# receiver.
ALERT_WEBHOOK_URL=
# Where the alert history lives (last 200 fired/resolved episodes, shown on
# the Overview). Kept whether or not a webhook is configured.
ALERT_HISTORY_FILE=/data/alerts.json
ALERT_RAM_PERCENT=90
ALERT_CPU_PERCENT=95
# Seconds between checks.
ALERT_INTERVAL=60
# Consecutive over-threshold checks before a RAM/CPU alert fires (a single
# spike won't page you). Host-offline and deployment-failed fire on the
# first check regardless.
ALERT_BREACH_CYCLES=2

# The rules below feed the Overview's Attention panel whether or not a
# webhook is set (the webhook just also pushes them to you).
#
# Disks: warn at this % full, critical at the second one.
ALERT_DISK_PERCENT=90
ALERT_DISK_CRITICAL_PERCENT=97
# ...and warn when a disk is on course to be full within this many days at
# its current rate of filling (critical at a quarter of it). The rate is a
# trend of free space over DISK_FORECAST_WINDOW (a PromQL range: 6h, 24h,
# 3d...) — longer smooths out a big download that gets deleted again.
ALERT_DISK_FORECAST_DAYS=7
DISK_FORECAST_WINDOW=24h
# CPU / GPU temperature (deg C).
ALERT_TEMP_CELSIUS=85
# A container is "crash-looping" once it has restarted this many times AND
# started within the last ALERT_RESTART_WINDOW_MINUTES (or Docker says it's
# mid-restart). Unhealthy healthchecks always alert.
ALERT_RESTART_COUNT=5
ALERT_RESTART_WINDOW_MINUTES=30
# A host's config backup (homelab-agent's BACKUP_* settings) is "stale"
# when its last success is older than this many hours. Leave blank/0 to
# derive it from the agent's own schedule (1.5x its interval, min +2h).
ALERT_BACKUP_MAX_AGE_HOURS=

# Service checks (Services tab). A check turns "down" only after this many
# failed probes in a row; WORKERS is how many probes can run at once.
CHECK_FAILURES_BEFORE_DOWN=2
CHECK_WORKERS=16

# Live "currently in use" badges on the Containers tab. Optional per app —
# easier to set from the dashboard itself (Settings > Live-activity
# credentials) than here; these env vars are just a fallback for anyone
# who'd rather configure it this way, and are only used when nothing's
# set in Settings. A container that's matched (by image name, or a
# manual override on its row) but has no credentials from either place
# just gets no badge (once logged, so check the logs if one seems
# missing). The backend talks to the app directly over the fleet network
# using the same host:port the dashboard would open in a new tab, so no
# URL to set.
#
# qBittorrent: WebUI login (Settings > WebUI in qBittorrent itself).
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Jellyfin: an API key from Dashboard > API Keys.
JELLYFIN_API_KEY=

# The machine running the dashboard is auto-detected (it matches its own
# container ID against the container lists reported by each registered
# agent) and gets its own full-width "Main System" section at the top.
# You don't need to set this — it's only an override for the rare case
# where auto-detection doesn't apply, e.g. the dashboard runs on a host
# with no homelab-agent on it. Set it to that machine's Prometheus job /
# agent HOST_NAME.
MAIN_HOST=

# Nodes are no longer listed here. Each homelab-agent registers itself on
# startup (see homelab-agent's DASHBOARD_URL / AGENT_URL / REGISTER_TOKEN
# env vars) and is picked up on the next WebSocket tick — nothing to edit
# in this repo when you add a machine.
